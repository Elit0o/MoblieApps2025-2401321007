<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.botops.app.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/zonesFragment"
        android:name="com.botops.app.ui.zones.ZonesFragment"
        android:label="Zones"
        tools:layout="@layout/fragment_zones" />

    <fragment
        android:id="@+id/robotsFragment"
        android:name="com.botops.app.ui.robots.RobotsFragment"
        android:label="Robots"
        tools:layout="@layout/fragment_robots" />

    <fragment
        android:id="@+id/waypointsFragment"
        android:name="com.botops.app.ui.waypoints.WaypointsFragment"
        android:label="Waypoints"
        tools:layout="@layout/fragment_waypoints" />

    <fragment
        android:id="@+id/tasksFragment"
        android:name="com.botops.app.ui.tasks.TasksFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_tasks" />

    <fragment
        android:id="@+id/fleetMapFragment"
        android:name="com.botops.app.ui.map.FleetMapFragment"
        android:label="Live Map"
        tools:layout="@layout/fragment_fleet_map" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.botops.app.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
