<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Robot:"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerRobot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Waypoint:"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerWaypoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/inputTaskStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Status (e.g. Pending, In Progress)"
        android:inputType="text" />

    <EditText
        android:id="@+id/inputTaskPriority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Priority (e.g. 1, 2, 3)"
        android:inputType="number" />

</LinearLayout>
